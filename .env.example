# Populated by neon deploy; do not commit actual values.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
NEON_BRANCH_ID=
NEON_FUNCTION_HOST_SUFFIX=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# Server-only account credentials
NAIVE_API_KEY=
NAIVE_SPECIALIST_VERSION=5
# Per-agent override when only intake changes; verify live versions before applying.
NAIVE_INTAKE_VERSION=6
NAIVE_INTAKE_ID=
NAIVE_FILES_API_KEY=
NAIVE_COORDINATOR_ID=
# Verified connector-free immutable version for crew reviews and legacy decision rounds.
NAIVE_GENERAL_AGENT_VERSION=
NAIVE_RUN_BUDGET_MICRO_USD=250000
# Comma-separated Neon Auth user IDs approved for operator routes and legacy grants; version-2 cases do not use this list
CREW_ALLOWED_USER_IDS=
AGENTPHONE_API_KEY=
AGENTPHONE_AGENT_ID=
AGENTPHONE_NUMBER_ID=
AGENTPHONE_NUMBER=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Historical ElevenLabs outreach agent and number; new calls use AgentPhone only
ELEVENLABS_OUTREACH_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
# Twilio Verify credentials are server-only; new voice calls remain AgentPhone-only
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
# Recipient for the scripts/test-call.ts check; set only for an explicitly authorized recipient
AUTHORIZED_TEST_NUMBER=
# Empty by default. Used only by legacy grants and operator-authorized drafts; version-2 owner permission does not use these lists.
OUTREACH_ALLOWED_PHONES=
OUTREACH_ALLOWED_EMAILS=

# Explicit routing only; no automatic retry across providers
OUTREACH_VOICE_PROVIDER=agentphone

# Base MCP URL; each managed session must bind /mcp/<caseId> with its own identity/vault credential.
NAIVE_CASE_TOOLS_URL=

# Optional explicit case when publishing a case-bound blueprint; leave empty for general review agents.
NAIVE_CASE_TOOL_CASE_ID=

# Enable only after provisioning access is configured and verified. The server-only setup key goes to the firm, autopoll and cases Functions.
NAIVE_CASE_PROVISIONING_ENABLED=false
NAIVE_SETUP_API_KEY=

# Phone accounts. PHONE_FLOW_ENABLED gates inbound intake and case SMS and stays false; sign-in and onboarding use their own gates.
PHONE_FLOW_ENABLED=false
PHONE_AUTH_BASE_URL=
PHONE_AUTH_SECRET=
AGENTPHONE_WEBHOOK_SECRET=
# Optional case-SMS rollout list; when set, only these numbers receive it. Empty applies no list; PHONE_FLOW_ENABLED and consent still gate sending.
PHONE_ALLOWED_NUMBERS=

# Separate phone sign-in gate; Twilio Verify sends the codes when PHONE_SMS_PROVIDER=twilio_verify.
PHONE_LOGIN_ENABLED=false
PHONE_SMS_PROVIDER=
# Test-only configuration; never populate production with a fixed verification code.
PHONE_TEST_NUMBERS=
PHONE_TEST_CODE=
TWILIO_VERIFY_SERVICE_SID=

# Optional Mac Messages notification bridge (never used for OTPs)
PHONE_NOTIFICATION_PROVIDER=agentphone
MAC_MESSAGES_BRIDGE_ENABLED=false
MAC_MESSAGES_TRANSPORT=sms
MAC_MESSAGES_SENDER_LABEL=
MAC_MESSAGES_BRIDGE_TOKEN=
# Local runner values belong in ignored .env.bridge.local, not frontend configuration.

# Engine for newly activated version-2 cases; existing cases keep their registered engine.
ASSURANCE_CASE_ENGINE=direct_openai
# Required positive provider cap for Naive v2, set from available organization credit; no top-up.
NAIVE_OPEN_SESSION_BUDGET_MICRO_USD=
# Dedicated v2 coordinator avoids changing legacy coordinator budgets/configuration.
NAIVE_OPEN_COORDINATOR_ID=
NAIVE_OPEN_GENERAL_AGENT_VERSION=

# Naïve company runtime (server-only). Enable once role bindings are configured; schedules have a separate switch.
ASSURANCE_FIRM_ENABLED=false
ASSURANCE_FIRM_SCHEDULES_ENABLED=false
ASSURANCE_FIRM_TOOLS_URL=
ASSURANCE_FIRM_TOKENS=
ASSURANCE_FIRM_REGISTRY={}
ASSURANCE_FIRM_BOARD_ID=
ASSURANCE_FIRM_MODEL=openai/gpt-5.4-mini
ASSURANCE_FIRM_BUDGET_MICRO_USD=
AGENTMAIL_PUBLIC_INBOX_ID=
AGENTMAIL_PUBLIC_EMAIL=
AGENTMAIL_WEBHOOK_URL=
AGENTMAIL_WEBHOOK_SECRET=
NAIVE_GMAIL_AUTH_CONFIG_ID=
STRIPE_TEST_SECRET_KEY=
# Set to a window actually supported by ASSURANCE_FIRM_MODEL in Naïve's catalog.
ASSURANCE_FIRM_WINDOW=immediate

# Naive runtime verified for company MCP continuation.
ASSURANCE_FIRM_HARNESS=vetta
