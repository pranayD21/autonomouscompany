# Populated by neon deploy; do not commit actual values.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
NEON_BRANCH_ID=
NEON_FUNCTION_HOST_SUFFIX=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# Server-only account credentials
NAIVE_API_KEY=
NAIVE_SPECIALIST_VERSION=5
# Per-agent override when only intake changes; verify live versions before applying.
NAIVE_INTAKE_VERSION=6
NAIVE_INTAKE_ID=
NAIVE_FILES_API_KEY=
NAIVE_COORDINATOR_ID=
# Verified connector-free immutable version for ordinary reviews and bounded decisions.
NAIVE_GENERAL_AGENT_VERSION=
NAIVE_RUN_BUDGET_MICRO_USD=250000
# Comma-separated Neon Auth user IDs approved to spend test credits
CREW_ALLOWED_USER_IDS=
AGENTPHONE_API_KEY=
AGENTPHONE_AGENT_ID=
AGENTPHONE_NUMBER_ID=
AGENTPHONE_NUMBER=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Dedicated discussion-plan agent and Twilio number imported into ElevenLabs
ELEVENLABS_OUTREACH_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
# Twilio Verify credentials are server-only; new voice calls remain AgentPhone-only
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
# Set only for an explicitly authorized synthetic test recipient
AUTHORIZED_TEST_NUMBER=
# Empty by default. Each destination needs explicit authorization before a test.
OUTREACH_ALLOWED_PHONES=
OUTREACH_ALLOWED_EMAILS=

# Explicit routing only; no automatic retry across providers
OUTREACH_VOICE_PROVIDER=agentphone

# Base MCP URL; each managed session must bind /mcp/<caseId> with its own identity/vault credential.
NAIVE_CASE_TOOLS_URL=

# Optional explicit case when publishing a case-bound blueprint; leave empty for general review agents.
NAIVE_CASE_TOOL_CASE_ID=

# Enable only after provisioning access is configured and verified. Setup key goes only to autopoll.
NAIVE_CASE_PROVISIONING_ENABLED=false
NAIVE_SETUP_API_KEY=

# Phone-first account and inbound intake (keep disabled until SMS registration and live verification)
PHONE_FLOW_ENABLED=false
PHONE_AUTH_BASE_URL=
PHONE_AUTH_SECRET=
AGENTPHONE_WEBHOOK_SECRET=
# Explicit consenting synthetic-test recipients; empty means no SMS can be sent
PHONE_ALLOWED_NUMBERS=

# Separate phone login; disabled until Verify setup and a consenting live test pass.
PHONE_LOGIN_ENABLED=false
PHONE_SMS_PROVIDER=
# Test-only configuration; never populate production with a fixed verification code.
PHONE_TEST_NUMBERS=
PHONE_TEST_CODE=
TWILIO_VERIFY_SERVICE_SID=

# Optional Mac Messages notification bridge (never used for OTPs)
PHONE_NOTIFICATION_PROVIDER=agentphone
MAC_MESSAGES_BRIDGE_ENABLED=false
MAC_MESSAGES_TRANSPORT=sms
MAC_MESSAGES_SENDER_LABEL=
MAC_MESSAGES_BRIDGE_TOKEN=
# Local runner values belong in ignored .env.bridge.local, not frontend configuration.
